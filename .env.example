# ─────────────────────────────────────────────────────────────────
# AICTEProFlow — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────────

# ── GROQ (required for autonomous agent loop) ────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Model selection ───────────────────────────────────────────────
# Options: llama-3.3-70b-versatile | llama3-8b-8192 | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Tavily (optional — for web research tool) ────────────────────
# Get free key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Frontend (Vite) — set this to point to the backend
# ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────
# PostgreSQL Configuration (Optional — Falls back to SQLite)
# ─────────────────────────────────────────────────────────────────
# Either supply a unified DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/campusflow
# Or supply individual host/user settings:
# POSTGRES_HOST=localhost
# POSTGRES_DB=campusflow
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────────
# Google OAuth & Gmail API v1 (Two-Factor Authentication & Password Reset)
# ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
GMAIL_SENDER_EMAIL=your_sender_email@gmail.com
JWT_SECRET=your_jwt_secret_token_key

